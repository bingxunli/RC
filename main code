gwas_cache <- list()


read_gwas_file_cached <- function(phenocode) {
  if (phenocode %in% names(gwas_cache)) {
    return(gwas_cache[[phenocode]])
  }
  
  filename <- paste0('finngen_R12_', phenocode, '.gz')
  if (file.exists(filename)) {
    gwas <- fread(filename, data.table = F)
    colnames(gwas)[1] <- 'chr'
    colnames(gwas)[2] <- 'pos'
    colnames(gwas)[5] <- 'rsid'
    gwas_cache[[phenocode]] <<- gwas  
    return(gwas)
  } else {
    warning("文件不存在: ", filename)
    return(NULL)
  }
}

