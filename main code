setwd("E:/circulation")
file_list <- list.files(pattern = "\\.gz$")
all_results <- list()
for (file in file_list) {
  tryCatch({
    phenocode <- gsub("finngen_R12_", "", file)
    phenocode <- gsub("\\.gz$", "", phenocode)
    phenotype_name <- finn12$phenotype[finn12$phenocode == phenocode]
    if (length(phenotype_name) == 0) {
      message(paste("No phenotype found for", phenocode, ", skipping..."))
      next
    }
    
    message(paste("Processing:", file))
    data <- fread(file, data.table = FALSE)
    
    data$Phenotype <- phenotype_name
    
    data_formatted <- format_data(
      data,
      type = "outcome",
       snps =RC_clump$SNP,
      header = TRUE,
      phenotype_col = "Phenotype",
      snp_col = "rsids",
      beta_col = "beta",
      se_col = "sebeta",
      eaf_col = "af_alt",
      effect_allele_col = "alt",
      other_allele_col = "ref",
      pval_col = "pval",
      chr_col = "#chrom",
      pos_col = "pos"
    )
    
    harmonise_data <- harmonise_data(exposure_dat = RC_clump, outcome_dat = data_formatted)
    
    res <- mr(harmonise_data)
    res <- generate_odds_ratios(res)
    het <- mr_heterogeneity(harmonise_data)
    pleio <- mr_pleiotropy_test(harmonise_data)
    
    res$phenocode <- phenocode
    het$phenocode <- phenocode
    pleio$phenocode <- phenocode
    
    all_results[[phenocode]] <- list(
      mr_results = res,
      heterogeneity = het,
      pleiotropy = pleio
    )
    
    rm(data, data_formatted, harmonise_data, res, het, pleio)
    gc()
    
  }, error = function(e) {
    message(paste("Error processing file:", file, "\nError message:", e$message))
  })
}

final_mr_results <- do.call(rbind, lapply(all_results, function(x) x$mr_results))
final_heterogeneity <- do.call(rbind, lapply(all_results, function(x) x$heterogeneity))
