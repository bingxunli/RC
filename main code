#identify novel SNPs (> 500 kb)
orig_loci <- rbind(RC_UKB_clump [,c('rsid','chr','pos')],
                   Karjalainen_RC_clump[,c('rsid','chr','pos')],
                   use.names=FALSE) %>% distinct(rsid,.keep_all = TRUE)
orig_loci$chr <- as.numeric(orig_loci$chr)
orig_loci$pos <- as.numeric(orig_loci$pos)

filter_list <- list()
for (i in 1:nrow(orig_loci)){
  filter_list[[i]] <- subset(RC_clump, chr == orig_loci$chr [i] & 
                               pos>= orig_loci$pos[i] - 500000 & 
                               pos <= orig_loci$pos[i] + 500000)
}
filter_list <- do.call(rbind, filter_list) %>% distinct(rsid, .keep_all = TRUE)
RC_filtered <- subset(RC_clump, ! rsid %in% filter_list$rsid)
write.table(RC_clump, 'RC_clump.txt', sep='\t', quote=FALSE, row.names=FALSE)
write.table(RC_filtered, 'RC_filtered.txt', sep='\t', quote=FALSE, row.names=FALSE)

####annovar####
RC_clump <- fread('RC_clump.txt')
RC_clump_clean <- na.omit(RC_clump)
fix_df <- data.frame(
  CHROM = as.character(RC_clump_clean$chr),  
  POS = as.character(RC_clump_clean$pos),
  ID = RC_clump_clean$rsid,
  REF = RC_clump_clean$other_allele,
  ALT = RC_clump_clean$effect_allele,
  QUAL = ".", 
  FILTER = "PASS", 
  INFO = paste0(
    "AF=", round(RC_clump_clean$eaf, 6),
    ";BETA=", round(RC_clump_clean$beta, 6),
    ";SE=", round(RC_clump_clean$se, 6),
    ";P=", RC_clump_clean$pval,
    ";Z=", round(RC_clump_clean$Z, 6),
    ";N=", RC_clump_clean$N
  ),
  stringsAsFactors = FALSE
)
format_col <- "GT:GQ:DP"  
sample_col <- paste0("0/1:", 
                     round(runif(nrow(RC_clump_clean), 40, 60)), ":",  
                     round(runif(nrow(RC_clump_clean), 5, 20)))        

gt_df <- data.frame(
  FORMAT = format_col,
  SAMPLE = sample_col, 
