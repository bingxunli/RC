run_single_coloc <- function(snp_rsid, gwas_phenocode, gwas_outcome, gwas_data = NULL) {
  cat("分析: ", snp_rsid, " - ", gwas_phenocode, "\n")
  
  snp_info <- RC_clump %>% filter(rsid == snp_rsid)
  if (nrow(snp_info) == 0) return(NULL)
  
  chr <- snp_info$chr
  pos <- snp_info$pos
  
  snp_region <- RC %>% 
    filter(chr == !!chr,
           pos >= !!pos - window_size,
           pos <= !!pos + window_size)
  
  if (nrow(snp_region) == 0) return(NULL)
  
  if (is.null(gwas_data)) {
    gwas_data <- read_gwas_file_cached(gwas_phenocode)
  }
  if (is.null(gwas_data)) return(NULL)
  
  data <- merge(snp_region, gwas_data, by = "rsid")
  data <- data[!duplicated(data$rsid), ]
  data <- data[complete.cases(data$beta.x, data$beta.y), ]
  data <- data %>% filter((effect_allele == alt & other_allele == ref) | 
                            (effect_allele == ref & other_allele == alt))
  
  if (nrow(data) == 0) return(NULL)
  
  data <- data %>% mutate(beta.x = ifelse(effect_allele == alt, beta.x, -beta.x))
  data$VAR.x <- data$se^2
  data$VAR.y <- data$sebeta^2
  data <- data[data$VAR.x != 0 & data$VAR.y != 0, ]
  
  data1 = data[, c("beta.x", "VAR.x", "rsid", 'eaf', 'N')]
  data2 = data[, c("beta.y", "VAR.y", "rsid")]
  colnames(data1) = c("beta", "varbeta", "snp", 'MAF', 'N')
  colnames(data2) = c("beta", "varbeta", 'snp')
  data1 = as.list(data1)
  data2 = as.list(data2)
  data1$type = "quant"
  data2$type = "cc"
  
  tryCatch({
    res <- coloc.abf(data1, data2)
    
    result <- data.frame(
      snp = snp_rsid,
      gwas = gwas_phenocode,
      outcome = gwas_outcome,
      PP.H0 = res$summary["PP.H0.abf"],
      PP.H1 = res$summary["PP.H1.abf"],
      PP.H2 = res$summary["PP.H2.abf"],
      PP.H3 = res$summary["PP.H3.abf"],
      PP.H4 = res$summary["PP.H4.abf"],
      nsnps = res$summary["nsnps"],
      stringsAsFactors = FALSE
    )
    
    need_result <- res$results %>% dplyr::arrange(desc(SNP.PP.H4))
    top_snp <- need_result$snp[1]
    top_pph4 <- need_result$SNP.PP.H4[1]
    
    result$top_coloc_snp <- top_snp
    result$top_snp_pph4 <- top_pph4
    
    if (result$PP.H4 > pph4_threshold) {
      tryCatch({
        plot_filename <- paste0("coloc_plots/", snp_rsid, "_", gwas_phenocode, ".pdf")
        
        p <- locuscompare(in_fn1 = gwas_data, 
                          in_fn2 = snp_region, 
                          title1 = gwas_phenocode, 
                          snp = top_snp, 
                          title2 = paste0('RC_', snp_rsid))
        
        
        pdf(plot_filename, width = 10, height = 8)
        print(p)
        dev.off()
        
        cat("  已生成PDF图形:", plot_filename, "\n")
        cat("  最高后验概率SNP:", top_snp, "(PP.H4 =", round(top_pph4, 3), ")\n")
        
      }, error = function(e) {
        message("  locuscompare画图失败: ", e$message)
      })
    }
    
    return(result)
    
  }, error = function(e) {
    message("  coloc分析失败: ", e$message)
    return(NULL)
  })
}

all_results <- list()
counter <- 0
total_analyses <- nrow(sig_gwas) * length(target_snps)

for (i in 1:nrow(sig_gwas)) {
  gwas_info <- sig_gwas[i, ]
  phenocode <- gwas_info$phenocode
  
  cat("\n处理GWAS:", i, "/", nrow(sig_gwas), "-", phenocode, "\n")
  
  gwas_data <- read_gwas_file_cached(phenocode)
  if (is.null(gwas_data)) {
    cat("  跳过GWAS（文件不存在或读取失败）:", phenocode, "\n")
    next
  }
  
  for (snp in target_snps) {
    counter <- counter + 1
    cat("  进度: ", counter, "/", total_analyses, "- SNP:", snp, "\n")
    
    result <- run_single_coloc(snp, phenocode, gwas_info$outcome, gwas_data)
    
    if (!is.null(result)) {
      all_results[[paste(snp, phenocode, sep = "_")]] <- result
    }
  }
}

