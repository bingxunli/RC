RC=fread('METAANALYSIS2.TBL',data.table = F) 
colnames(RC)
RC$se <- 1/sqrt(2*RC$Freq1*(1-RC$Freq1)*(RC$Freq1)*(RC$Weight+(RC$Zscore)^2))
RC$beta <-(RC$Zscore)*(RC$se)
# se and beta were calculated according to reference: PMID: 27019110
