setwd("C:/Users/bingxun li/Desktop/RC/test")
RC <- fread('RC.txt')
head(RC)
RC_clump <- RC|> ieugwasr::ld_clump(RC,clump_kb = 10000,
                                    clump_r2 = 0.001,
                                    clump_p = 5e-8,
                                    pop = "EUR",
                                    plink_bin = "C:/Users/bingxun li/AppData/Local/R/win-library/4.3/plinkbinr/bin/plink_Windows.exe",
                                    bfile = "C:/Users/bingxun li/Desktop/1kgv3/EUR")
plink_bin <- "C:/Users/bingxun li/AppData/Local/R/win-library/4.3/plinkbinr/bin/plink_Windows.exe"
bfile_path <- "C:/Users/bingxun li/Desktop/1kgv3/EUR"
dir.create("finemapping_results", showWarnings = FALSE)
dir.create("finemapping_plots", showWarnings = FALSE)

dir.create("ld_data", showWarnings = FALSE)

FINEMAP_WINDOW <- 500000 
HIGH_PIP_THRESHOLD <- 0.99
LD_THRESHOLD <- 0.1 
CONFIDENCE_SET_THRESHOLD <- 0.95  

if(file.exists("all_finemapping_results.csv")) {
  all_results <- fread("all_finemapping_results.csv")
  cat("检测到已有结果文件，将从中断处继续运行...\n")
} else {
  all_results <- data.table()
}

completed_files <- list.files("finemapping_results", pattern = "_finemapping\\.csv$", full.names = FALSE)
completed_snps <- gsub("_finemapping\\.csv", "", completed_files)
cat("已完成的SNP数量:", length(completed_snps), "\n")
if(length(completed_snps) > 0) {
  cat("已完成的SNP:", paste(completed_snps, collapse = ", "), "\n")
}

for(i in 1:nrow(RC_clump)) {
  snp <- RC_clump[i, ]
  snp_rsid <- snp$rsid
  snp_chr <- snp$chr
  snp_pos <- snp$pos
  
  if(snp_rsid %in% completed_snps) {
    cat("跳过已处理的SNP:", snp_rsid, "(已有结果文件)\n")
    
    if(nrow(all_results) == 0 || !any(all_results$lead_snp == snp_rsid)) {
      single_file <- paste0("finemapping_results/", snp_rsid, "_finemapping.csv")
      if(file.exists(single_file)) {
        single_data <- fread(single_file)
        all_results <- rbind(all_results, single_data, fill = TRUE)
        cat("已从文件加载", snp_rsid, "的结果数据\n")
      }
    }
    next
  }
  
  cat("正在处理:", snp_rsid, "染色体:", snp_chr, "位置:", snp_pos, "\n")
  cat("使用fine-mapping窗口大小: ±", FINEMAP_WINDOW/1000, "kb\n", sep = "")
  cat("高PIP阈值:", HIGH_PIP_THRESHOLD, "LD阈值:", LD_THRESHOLD, "\n")
  
  target_start <- snp_pos - FINEMAP_WINDOW
  target_end <- snp_pos + FINEMAP_WINDOW
  
  gwas_region <- RC %>%
    dplyr::filter(chr == snp_chr & pos >= target_start & pos <= target_end)
  
  cat("区域内的SNP数量:", nrow(gwas_region), "\n")
  
  if(nrow(gwas_region) > 10000) {
    cat("警告: 区域内SNP数量较多 (", nrow(gwas_region), ")，可能需要较长时间计算\n", sep = "")
  }
  
  tryCatch({
    ld_matrix <- ld_matrix(gwas_region$rsid,
                           pop = "EUR",
                           plink_bin = plink_bin,
                           bfile = bfile_path,
                           with_alleles = FALSE)
    
    snps_in_ld <- rownames(ld_matrix)
    
    gwas_region_filtered <- gwas_region %>%
      dplyr::filter(rsid %in% snps_in_ld)
    
    gwas_region_filtered <- gwas_region_filtered[match(snps_in_ld, gwas_region_filtered$rsid), ]
    
    if(all(rownames(ld_matrix) == gwas_region_filtered$rsid)) {
      cat("✓ GWAS数据和LD矩阵顺序匹配成功\n")
    } else {
      cat("警告: GWAS数据和LD矩阵顺序不匹配，尝试重新排序\n")
      gwas_region_filtered <- gwas_region_filtered[match(rownames(ld_matrix), gwas_region_filtered$rsid), ]
    }
    
    if(snp_rsid %in% colnames(ld_matrix)) {
      ld_with_lead <- ld_matrix[, snp_rsid]
      gwas_region_filtered$r2_with_lead <- ld_with_lead[gwas_region_filtered$rsid]
    } else {
      cat("警告: lead SNP", snp_rsid, "不在LD矩阵中\n")
      gwas_region_filtered$r2_with_lead <- NA
    }
    
    z_scores <- gwas_region_filtered$Z
    avg_sample_size <- mean(gwas_region_filtered$N, na.rm = TRUE)
    
    fitted_susie <- susie_rss(z = z_scores, 
                              R = ld_matrix, 
                              n = avg_sample_size,
                              estimate_residual_variance = F,
                              max_iter = 500)
    
    pip <- fitted_susie$pip
    names(pip) <- gwas_region_filtered$rsid
    
    results_df <- gwas_region_filtered[, c("rsid", "chr", "pos", "pval", "beta", "se", "Z", "r2_with_lead")]
    results_df$PIP <- pip
    results_df <- results_df[order(-results_df$PIP), ]
    
    results_df$pval <- as.numeric(results_df$pval)
    
    results_df <- results_df %>%
      mutate(
        high_pip_basic = (PIP > HIGH_PIP_THRESHOLD & pval < 5e-8),
        
        high_pip_ld_aware = (PIP > HIGH_PIP_THRESHOLD & 
                               pval < 5e-8 &
                               (!is.na(r2_with_lead) & r2_with_lead < LD_THRESHOLD)),
        
        cumulative_pip = cumsum(PIP),
        in_95_credible_set = (cumulative_pip <= CONFIDENCE_SET_THRESHOLD | 
                                PIP == max(PIP[cumulative_pip <= CONFIDENCE_SET_THRESHOLD])),
        
        recommended_causal = case_when(
          PIP > HIGH_PIP_THRESHOLD & pval < 5e-8 & 
            !is.na(r2_with_lead) & r2_with_lead < LD_THRESHOLD ~ TRUE,
          
          PIP > HIGH_PIP_THRESHOLD & pval < 5e-8 & 
            is.na(r2_with_lead) ~ TRUE,
          
          TRUE ~ FALSE
        )
      )
    
    results_df$lead_snp <- snp_rsid
    results_df$lead_snp_chr <- snp_chr
    results_df$lead_snp_pos <- snp_pos
    
    all_results <- rbind(all_results, results_df, fill = TRUE)
    
    write.csv(all_results, "all_finemapping_results.csv", row.names = FALSE)
    
    write.csv(results_df, 
              file = paste0("finemapping_results/", snp_rsid, "_finemapping.csv"), 
              row.names = FALSE)
    
    write.csv(ld_matrix, 
              file = paste0("ld_data/", snp_rsid, "_ld_matrix.csv"), 
              row.names = TRUE)
    
    results_df$pos <- as.numeric(results_df$pos)
    
    pdf(file = paste0("finemapping_plots/", snp_rsid, "_finemapping.pdf"), 
        width = 14, height = 10)  # 调整高度，去掉基因区域
    
    layout(matrix(c(1, 2), nrow = 2, ncol = 1), heights = c(8, 1.5))
    
    par(mar = c(4, 4, 4, 2) + 0.1)
    colors <- ifelse(!is.na(results_df$r2_with_lead),
                     colorRampPalette(c("lightblue", "darkred"))(100)[cut(results_df$r2_with_lead, 
                                                                          breaks = 100, 
                                                                          labels = FALSE)],
                     "gray")
    
