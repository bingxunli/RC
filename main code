####smr using mqtl from Hatton et al. 2024 Nat Commun####
#https://www.nature.com/articles/s41467-024-47005-0
#https://yanglab.westlake.edu.cn/data/SMR/EUR.tar.gz
file_list <- list.files(pattern = "blood_mqtl[0-9]+\\.smr$")
if (length(file_list) == 0) {
  stop("No blood_mqtl*.smr files found in the directory")
}
message(paste("Found", length(file_list), "blood_mqtl*.smr files"))
all_smr_data <- list()
for (file in file_list) {
  tryCatch({
    data <- fread(file, data.table = FALSE)
    data$source_file <- file
    file_number <- as.numeric(gsub("blood_mqtl([0-9]+)\\.smr", "\\1", file))
    data$file_number <- file_number
    all_smr_data[[file]] <- data
    message(paste("Successfully read:", file, "with", nrow(data), "rows"))
    
  }, error = function(e) {
    message(paste("Error reading file:", file, "\nError message:", e$message))
  })
}
combined_smr_data <- do.call(rbind, all_smr_data)
threshold <- 0.05 / 135287
head(combined_smr_data)
filtered_mqtl_smr <-subset(combined_smr_data, p_SMR < threshold & p_HEIDI > 0.05)
write.table(filtered_mqtl_smr,'filtered_mqtl_smr.csv',row.names =F,col.names = T,sep = '\t',quote = F)
